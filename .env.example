# 복사해서 .env 파일로 저장하고 값을 채우세요. (.env는 GitHub에 올라가지 않습니다)
VITE_SUPABASE_URL=https://tnpbliawewjtnhubcqei.supabase.co
# Supabase 대시보드 > Project Settings > API Keys 의 publishable(anon) 키
VITE_SUPABASE_PUBLISHABLE_KEY=
# service_role / secret 키는 화면 코드나 .env.example에 절대 넣지 마세요

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키
# JavaScript 키: 지도 표시용 (브라우저에 노출되어도 되는 키, 대신 콘솔에 사이트 도메인 등록 필수)
VITE_KAKAO_MAP_JS_KEY=
# REST API 키: 주소→좌표 변환(db/geocode.py)용. VITE_ 접두사를 붙이지 마세요 (화면 코드에 노출 금지)
KAKAO_REST_API_KEY=
